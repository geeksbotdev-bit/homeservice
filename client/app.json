{
  "expo": {
    "name": "uroojwithus",
    "slug": "homeservice-client",
    "scheme": "homeservice",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.homeservice.client"
    },
    "android": {
      "package": "com.homeservice.client",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "uroojwithus"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "uroojwithus uses your location to detect your address and match you with nearby cleaners."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6407f7f2-b56a-4126-84a9-8ab12c3483a7"
      }
    },
    "owner": "geeksbot"
  }
}
