# ── Dependencies ──
node_modules/

# ── Stray duplicate server copy inside client (not used) ──
client/server/

# ── Secrets / environment (NEVER commit) ──
.env
.env.*
!.env.example

# ── Databases (local dev) ──
*.db
*.db-journal
*.sqlite
prisma/*.db

# ── Expo / React Native build output ──
.expo/
dist/
web-build/
*.tsbuildinfo
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision
*.orig.*

# ── Logs ──
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# ── Uploaded ID documents / selfies (never commit user documents) ──
uploads/
server/uploads/

# ── OS / editor ──
.DS_Store
Thumbs.db
.idea/
