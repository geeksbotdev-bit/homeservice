# Copy to .env and fill in real values (never commit .env)
PORT=4000
JWT_SECRET=change-me-in-production
ADMIN_KEY=change-me
DATABASE_URL="file:./dev.db"

# Firebase (admin)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Bank Alfalah (MPGS) payment gateway
BAFL_MERCHANT_ID=your-merchant-id
BAFL_API_PASSWORD=your-api-password
BAFL_BASE_URL=https://test-bankalfalah.gateway.mastercard.com
BAFL_API_VERSION=100
SELF_URL=http://localhost:4000
CLIENT_URL=http://localhost:8081
