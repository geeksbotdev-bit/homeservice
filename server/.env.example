# Copy to .env and fill in real values (never commit .env)
PORT=4000
JWT_SECRET=change-me-in-production
ADMIN_KEY=change-me
# PostgreSQL (Neon / Vercel Postgres / Supabase). Same URL works locally too.
# e.g. postgresql://user:pass@host/db?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Firebase (admin)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Bank Alfalah (MPGS) payment gateway
BAFL_MERCHANT_ID=your-merchant-id
BAFL_API_PASSWORD=your-api-password
BAFL_BASE_URL=https://test-bankalfalah.gateway.mastercard.com
BAFL_API_VERSION=100
SELF_URL=http://localhost:4000
CLIENT_URL=http://localhost:8081
